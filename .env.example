# Django Core
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite; set USE_MYSQL=true to connect to MySQL)
USE_MYSQL=false
DB_NAME=chatbot
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# LLM Provider: gemini | claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Embeddings & Retrieval
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional Web Search Fallback (Google Custom Search)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
